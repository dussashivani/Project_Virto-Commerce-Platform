# ==========================================
# VIRTO COMMERCE - LOCAL DOCKER CONFIGURATION
# ==========================================

# Docker images
PLATFORM_IMAGE=virtocommerce/platform@sha256:a109244223cb288cf832af296b0bc2548e95f266f8676ad714aee53183067de3
STOREFRONT_IMAGE=virtocommerce/storefront@sha256:7484bc25e2a516193b361a16127e65f2cd3c3404cd8ed525b84a375acb0c95d1

SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server@sha256:4525e3efac9f3e241cb003bb2ff2a82818b502f37e12049d788b1a9fa7e13b7f
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch@sha256:01c1732062b4a846c5ca687b0094b89bad0bfed00c6d71626db32fb8f3131a78
REDIS_IMAGE=redis@sha256:7f7d30b7fdd09467bac58198a1f166dd69789d348d4fe859cccb20e0cf287fbe

# Database and cache passwords
# Preserve your existing generated values here
MSSQL_SA_PASSWORD=YOUR_EXISTING_SQL_PASSWORD
REDIS_PASSWORD=YOUR_EXISTING_REDIS_PASSWORD

# Platform configuration
VC_DB_NAME=VirtoCommerce
SEARCH_PROVIDER=ElasticSearch
SEARCH_SCOPE=default

# Local application ports
PLATFORM_HOST_PORT=8090
STOREFRONT_HOST_PORT=8080

# Storefront connection
PLATFORM_INTERNAL_URL=http://platform
STOREFRONT_API_USER=admin
STOREFRONT_API_PASSWORD=store

# Timezone
TZ=Asia/Kolkata
